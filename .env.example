# 複製成 .env(勿進版控)。
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8788
UPSTREAM_BASE=https://api.anthropic.com

# 預設通道:subscription(沿用 CLI 的訂閱 OAuth)或 apikey
DEFAULT_CHANNEL=subscription

# apikey 通道要用的金鑰;留空則 apikey 通道回 502。subscription 通道不需要。
ANTHROPIC_API_KEY=

# 對外(經 nginx /butler/)暴露時接受的「虛擬金鑰」,逗號分隔可多把。
# 對外裝置把此值當 api_key 用;gateway 驗證通過後換成上面的真 ANTHROPIC_API_KEY 轉發,
# 真 key 永不外洩。留空 = 不接受任何對外請求(/butler/ 一律 401)。
# 產生:  python3 -c "import secrets;print('bk-'+secrets.token_hex(24))"
GW_TOKENS=

# 對外(公網)驗證通過後走的通道:apikey(預設、安全)或 subscription(實驗性訂閱中繼)。
# subscription = 注入本機 claude.ai OAuth,讓外部裝置騎主機訂閱。
#   ⚠ 非官方支援、可能違反消費者條款、token 輪替時脆弱;僅供學習。啟用還需下面兩項 + compose 掛載憑證目錄。
PUBLIC_CHANNEL=apikey
# 訂閱中繼要讀的 OAuth 憑證檔(容器內路徑;由 compose 把主機 ~/.claude 目錄唯讀掛進來)。
# 留空 = 停用訂閱中繼。務必掛「目錄」而非單檔(token 刷新會換 inode)。
OAUTH_CREDENTIALS_FILE=
OAUTH_BETA=oauth-2025-04-20

# 上游是否再經 forward proxy(如 Squid)。留空 = 直連。
# 例:UPSTREAM_PROXY=http://user:PASSWORD@127.0.0.1:3128
UPSTREAM_PROXY=

ANTHROPIC_VERSION=2023-06-01
LOG_FILE=/app/logs/gateway.log
